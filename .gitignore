__pycache__/
*.pyc
.env
.venv/
dist/
build/
.eggs/
*.egg-info/

# Bundled Studio UI. Generated by `npm run build:bundle` and copied in at
# the release cut (see RELEASING.md); the wheel ships it via package-data,
# but it must never be committed. `__init__.py` stays tracked — it is what
# makes `rlmstudio._ui` a discovered package, and without it the wheel
# ships an empty UI.
src/rlmstudio/_ui/*
!src/rlmstudio/_ui/__init__.py

# Test / coverage artifacts
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Node artifacts that can land at the repo root if a dev accidentally
# runs `npm` / `npx` here instead of inside frontend/. The real
# frontend deps live in frontend/node_modules (separately ignored).
/node_modules/
/.vite/

# Playwright CLI artifacts
.playwright-cli/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Notebooks
notebooks/

# OS
.DS_Store
Thumbs.db

# Internal documentation - not for public repos
doc_internal/
DOC_INTERNAL/
.clinerules
.rlmkit_config.json
.rlmkit_sessions.json
CLAUDE.md
.claude/
.mcp.json
/.agents
AGENTS.md
/.codex
/specs/*
!/specs/dgx-spark-docs-refresh/
!/specs/rebrand-rlm-studio/
!/specs/interop-official-rlm/
!/specs/benchmarks-v1/
!/specs/rlm-working-state/
# Public texts fetched by `rlm-studio bench --fetch` (pinned by sha256 in the dataset)
/benchmarks/corpus/
/.git-rewrite
.env.test
